; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pocket Pet Remake Client"
run/main_scene="res://scenes/auth/login_scene.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
MessageRouter="*res://autoload/message_router.gd"
HttpClient="*res://autoload/http_client.gd"
NetClient="*res://autoload/net_client.gd"
App="*res://autoload/app.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=1080
window/size/window_height_override=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_render/layer_1="ground"
2d_render/layer_2="player"
2d_render/layer_3="npc"
2d_physics/layer_1="Ground"
2d_physics/layer_2="player"
2d_physics/layer_3="npc"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.0745098, 0.101961, 0.152941, 1)
