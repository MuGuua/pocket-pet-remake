; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Pocket Pet Remake Client"
run/main_scene="res://scenes/auth/login_scene.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
MessageRouter="*res://autoload/message_router.gd"
HttpClient="*res://autoload/http_client.gd"
NetClient="*res://autoload/net_client.gd"
App="*res://autoload/app.gd"
ItemIcons="*res://autoload/item_icons.gd"
SomeGlobal="*res://autoload/some_global.gd"

[dialogue_manager]

runtime/balloon_path="res://dialogue/balloon.tscn"

[display]

window/size/viewport_width=360
window/size/viewport_height=480
window/size/window_width_override=1082
window/size/window_height_override=1922
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://resources/ui/default_theme.tres"
theme/default_font_size=14

[input]

open_scene_npc_list={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":53,"physical_keycode":53,"key_label":53,"unicode":53,"location":0,"echo":false,"script":null)
]
}
open_main_menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":77,"physical_keycode":77,"key_label":77,"unicode":109,"location":0,"echo":false,"script":null)
]
}
open_player_panel={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":66,"physical_keycode":66,"key_label":66,"unicode":98,"location":0,"echo":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogue/untitled.dialogue", "res://dialogue/测试1.dialogue")

[layer_names]

2d_render/layer_1="ground"
2d_render/layer_2="player"
2d_render/layer_3="npc"
2d_physics/layer_1="Ground"
2d_physics/layer_2="player"
2d_physics/layer_3="npc"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.0745098, 0.101961, 0.152941, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
textures/stretch/scale=1.0
textures/stretch/aspect="expand"
